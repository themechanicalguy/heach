# TLS for every port (EN-01). No domain yet, so Caddy's internal CA issues a certificate for the
# host's IP address and browsers show a warning. With a domain, replace `tls internal` and the
# addresses below with the domain names to get publicly trusted certificates.
{
	default_sni {$PUBLIC_HOST}
	auto_https disable_redirects
	order rate_limit before basic_auth
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Only 80 and 443 are open to the internet (ADR 0008).
http://{$PUBLIC_HOST}:80 {
	redir https://{host}{uri} permanent
}

https://{$PUBLIC_HOST}:443 {
	tls internal
	import security_headers
	handle_path /api/* {
		# In the order written: rate limit, refuse test sign-in, then proxy.
		route {
			# Per client IP, before the API's own limits (SO-08.2). Pages and static assets are
			# not limited here.
			rate_limit {
				zone api_per_ip {
					key {remote_host}
					events 300
					window 1m
				}
			}
			# Test sign-in is never served to the internet (SE-07.23): only the loopback entry
			# on 9443 below. The API also refuses it without the key that entry adds.
			@test_login path_regexp test_login (?i)/auth/+test-login
			respond @test_login 404
			request_header -X-Test-Login-Key
			reverse_proxy api:3001
		}
	}
	handle {
		reverse_proxy web:3000
	}
}

# Admin is published on the host's loopback only; reach it through Session Manager port
# forwarding (SE-04), never from the internet.
https://{$PUBLIC_HOST}:8443 {
	tls internal
	import security_headers
	header Cache-Control "no-store"
	# The admin app calls the API on its own origin (AD-01); only admin routes, never test sign-in.
	handle_path /api/* {
		route {
			rate_limit {
				zone admin_api_per_ip {
					key {remote_host}
					events 300
					window 1m
				}
			}
			@not_admin not path /admin/*
			respond @not_admin 404
			request_header -X-Test-Login-Key
			reverse_proxy api:3001
		}
	}
	handle {
		reverse_proxy admin:8080
	}
}

# Web and API with test sign-in, for trusted developers: published on the host's loopback only,
# reached through Session Manager port forwarding like admin (SE-07.23). This entry adds the key
# the API requires for test sign-in; synthetic users only. `localhost` too: through port
# forwarding the browser asks for that name.
https://{$PUBLIC_HOST}:9443, https://localhost:9443 {
	tls internal
	import security_headers
	handle_path /api/* {
		reverse_proxy api:3001 {
			# Read per request: an unset key sends an empty one, which the API refuses.
			header_up X-Test-Login-Key {env.TEST_LOGIN_KEY}
		}
	}
	handle {
		reverse_proxy web:3000
	}
}
