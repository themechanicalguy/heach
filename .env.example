# Local development settings. Copy with `pnpm setup` (creates .env, which git ignores).
# Every value below is a local-only placeholder. Never put real credentials in this file,
# and never reuse these values anywhere else. Deployed environments use the secrets manager.

# --- Apps ---
# pnpm dev:up moves any of the *_PORT values below to the next free port if another program
# already uses it, and updates this file (and the matching URL) to match.
NODE_ENV=development
# local | test | dev | staging | production. Test login and local keys work only in local and test.
APP_ENV=local
API_PORT=3001
# Rate limit per route (SO-08): every request counts against its client address; a signed-in
# request also counts against its user. Defaults shown; uncomment to change.
# RATE_LIMIT_PER_ADDRESS_PER_MINUTE=200
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_WINDOW_SECONDS=60
WEB_PORT=3000
ADMIN_PORT=5173
# The web app proxies /api to the API locally (hosts route /api in Caddy instead).
API_ORIGIN=http://localhost:3001
# Optional; CI sets it. Empty means "dev".
BUILD_VERSION=

# --- PostgreSQL (docker compose service "postgres") ---
POSTGRES_USER=heach_local
POSTGRES_PASSWORD=local-only-not-a-secret
POSTGRES_DB=heach_local
# 5433 rather than 5432, the port other local PostgreSQL servers usually take.
POSTGRES_PORT=5433
# Superuser (the three values above): used only by `pnpm --filter @heach/api db:bootstrap`.
DATABASE_ADMIN_URL=postgresql://heach_local:local-only-not-a-secret@localhost:5433/heach_local
# Migrations role and API role, created by db:bootstrap (EN-10.2). TLS is always on (EN-01.1).
DATABASE_MIGRATOR_URL=postgresql://heach_migrator@localhost:5433/heach_local
DATABASE_MIGRATOR_PASSWORD=local-only-not-a-secret
DATABASE_URL=postgresql://heach_app@localhost:5433/heach_local
DATABASE_PASSWORD=local-only-not-a-secret
# CA for PostgreSQL and Redis TLS; pnpm setup creates .certs/ and writes the absolute path here.
DATA_TLS_CA_FILE=<generate:ca-file>

# --- Redis (service "redis") ---
REDIS_PASSWORD=local-only-not-a-secret
REDIS_PORT=6379
REDIS_URL=rediss://:local-only-not-a-secret@localhost:6379/0

# --- S3-compatible object store (service "s3", SeaweedFS) ---
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=heach-local
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=local-only-access-key
S3_SECRET_ACCESS_KEY=local-only-not-a-secret

# --- Email and SMS catcher (service "mailpit"); inbox at http://localhost:8025 ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# SMS goes through the SmsSender port. `local` delivers each SMS (OTP codes) to the Mailpit inbox
# above, through Mailpit's API; `fake` keeps them in memory (tests). There is no real SMS provider
# yet (DLT registration, #20). Nothing real is sent.
SMS_PROVIDER=local
MAILPIT_API_URL=http://localhost:8025
# OTP caps (SE-08); defaults shown. Local E2E runs from one address may raise the address caps.
# OTP_SENDS_PER_NUMBER_PER_HOUR=5
# OTP_SENDS_PER_NUMBER_PER_DAY=10
# OTP_SENDS_PER_DEVICE_PER_HOUR=10
# OTP_SENDS_PER_ADDRESS_PER_HOUR=30
# OTP_FAILURES_PER_ADDRESS_PER_HOUR=30

# --- Keys (EN-04, EN-09) ---
# Hosts use AWS KMS (KEY_PROVIDER=kms) and Parameter Store. Locally a KMS test double derives
# keys from LOCAL_KEY_SEED; pnpm setup writes random local-only values for both lines below.
SECRETS_SOURCE=env
# Server feature flags on in this environment (FF-01.1), each allowed only in local, test and dev:
# accounts (OTP sign-in, setup, admin sign-in). Add sample-patient-note to reach the Step 2 sample
# note and test sign-in (`/notes`); off by default, as it is not part of the product. Add
# doctor-and-clinic only to work on the doctor, dentist, dermatologist and clinic front desk roles,
# deferred beyond the MVP (ADR 0015); never in staging or production.
FEATURE_FLAGS=accounts
KEY_PROVIDER=local
LOCAL_KEY_SEED=<generate:hex32>
BLIND_INDEX_KEY=<generate:hex32>

# --- Tracing (service "otel-collector", UI from "jaeger" at http://localhost:16686) ---
OTEL_HTTP_PORT=4318
JAEGER_UI_PORT=16686
OTEL_METRICS_PORT=8889
# The API sends traces and metrics here; empty turns telemetry off (as on the dev host).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Optional local observability (`docker compose --profile observability up -d`) ---
# Prometheus and Grafana (LM-05.1 dashboard), GlitchTip (LM-03.1 front-end errors). Local only.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3300
GRAFANA_ADMIN_PASSWORD=<generate:hex32>
GLITCHTIP_PORT=8000
GLITCHTIP_DB_PASSWORD=<generate:hex32>
GLITCHTIP_SECRET_KEY=<generate:hex32>
