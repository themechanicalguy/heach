# Local development settings. Copy with `pnpm setup` (creates .env, which git ignores).
# Every value below is a local-only placeholder. Never put real credentials in this file,
# and never reuse these values anywhere else. Deployed environments use the secrets manager.

# --- Apps ---
# pnpm dev:up moves any of the *_PORT values below to the next free port if another program
# already uses it, and updates this file (and the matching URL) to match.
NODE_ENV=development
# local | test | dev | staging | production. Test login and local keys work only in local and test.
APP_ENV=local
API_PORT=3001
WEB_PORT=3000
ADMIN_PORT=5173
# Optional; CI sets it. Empty means "dev".
BUILD_VERSION=

# --- PostgreSQL (docker compose service "postgres") ---
POSTGRES_USER=heach_local
POSTGRES_PASSWORD=local-only-not-a-secret
POSTGRES_DB=heach_local
# 5433 rather than 5432, the port other local PostgreSQL servers usually take.
POSTGRES_PORT=5433
# Superuser (the three values above): used only by `pnpm --filter @heach/api db:bootstrap`.
DATABASE_ADMIN_URL=postgresql://heach_local:local-only-not-a-secret@localhost:5433/heach_local
# Migrations role and API role, created by db:bootstrap (EN-10.2). TLS is always on (EN-01.1).
DATABASE_MIGRATOR_URL=postgresql://heach_migrator@localhost:5433/heach_local
DATABASE_MIGRATOR_PASSWORD=local-only-not-a-secret
DATABASE_URL=postgresql://heach_app@localhost:5433/heach_local
DATABASE_PASSWORD=local-only-not-a-secret
# CA for PostgreSQL and Redis TLS; pnpm setup creates .certs/ and writes the absolute path here.
DATA_TLS_CA_FILE=<generate:ca-file>

# --- Redis (service "redis") ---
REDIS_PASSWORD=local-only-not-a-secret
REDIS_PORT=6379
REDIS_URL=rediss://:local-only-not-a-secret@localhost:6379/0

# --- S3-compatible object store (service "s3", SeaweedFS) ---
S3_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=heach-local
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=local-only-access-key
S3_SECRET_ACCESS_KEY=local-only-not-a-secret

# --- Email and SMS catcher (service "mailpit"); inbox at http://localhost:8025 ---
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
# "local" delivers SMS as emails to Mailpit (adapter arrives in Step 2). Nothing real is sent.
SMS_PROVIDER=local

# --- Keys (EN-04, EN-09) ---
# Hosts use AWS KMS (KEY_PROVIDER=kms) and Parameter Store. Locally a KMS test double derives
# keys from LOCAL_KEY_SEED; pnpm setup writes random local-only values for both lines below.
SECRETS_SOURCE=env
# Server feature flags on in this environment (FF-01.1); the sample note runs only locally, test, dev.
FEATURE_FLAGS=sample-patient-note
KEY_PROVIDER=local
LOCAL_KEY_SEED=<generate:hex32>
BLIND_INDEX_KEY=<generate:hex32>
