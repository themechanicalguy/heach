# Copy to .env and fill in locally. Never commit real values.
# Names only; values come from the secrets manager in deployed environments.

NODE_ENV=development
BUILD_VERSION=

# Data stores (local values arrive with Docker Compose in a later part)
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
