{
  "name": "heach",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12.8.1"
  },
  "scripts": {
    "prepare": "node scripts/hooks/install.mjs",
    "setup": "node scripts/setup.mjs",
    "dev": "turbo run dev",
    "dev:up": "node scripts/dev-up.mjs",
    "dev:down": "docker compose --profile init down",
    "services:up": "node scripts/dev-up.mjs --services-only",
    "services:reset": "docker compose --profile init down --volumes",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm lint:scripts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "lint:scripts": "eslint scripts",
    "test:scripts": "node --test 'scripts/**/*.test.mjs'",
    "credit:status": "node scripts/credit-status.mjs",
    "check": "turbo run lint typecheck test build && pnpm lint:scripts && pnpm test:scripts"
  },
  "devDependencies": {
    "@heach/config": "workspace:*",
    "@types/node": "24.19.1",
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
