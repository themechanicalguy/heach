# Dependencies
node_modules/

# Build output
dist/
.next/
out/
build/
*.tsbuildinfo
next-env.d.ts

# Tooling
.turbo/
coverage/
playwright-report/
test-results/
blob-report/

# Environment: never commit real values
.env
.env.*
!.env.example

# OpenTofu: state holds generated passwords; backend.hcl holds the account's bucket name.
# .terraform.lock.hcl (provider checksums) IS committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
backend.hcl
crash.log

# Logs
*.log
logs/

# OS and editor
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local TLS certificates for PostgreSQL and Redis (deploy/dev/make-certs.sh)
.certs/
certs/
