  "info": {
    "title": "HEACH API",
    "description": "",
    "version": "contract",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        },
        "required": ["status", "version"]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "postgres": {
            "type": "string",
            "enum": ["ok", "down"]
          },
          "redis": {
            "type": "string",
            "enum": ["ok", "down"]
          }
        },
        "required": ["postgres", "redis"]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "error"]
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          }
        },
        "required": ["status", "checks"]
      },
      "TestLoginDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["userId"]
      },
      "AccessTokenDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          }
        },
        "required": ["accessToken", "expiresIn"]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "allDevices": {
            "type": "boolean"
          }
        },
        "required": ["allDevices"]
      },
      "WebVitalDto": {
        "type": "object",
        "properties": {}
      },
      "CreateNoteDto": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 2000,
            "description": "Restricted: encrypted at rest"
          }
        },
        "required": ["body"]
      },
      "CreatedNoteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "createdAt"]
      },
      "NoteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "body": {
            "type": "string",
            "description": "Restricted"
          }
        },
        "required": ["id", "createdAt", "body"]
      }
    }
  }
}
