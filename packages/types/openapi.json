          }
        },
        "required": ["email", "role"]
      },
      "UserSummaryDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Masked"
          },
          "mobile": {
            "type": "string",
            "nullable": true,
            "description": "Last four digits only"
          },
          "status": {
            "type": "string",
            "enum": ["active", "suspended"]
          },
          "suspensionReason": {
            "type": "string",
            "enum": ["safety_concern", "fraud", "policy_breach", "user_request", "other"],
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleGrantDto"
            }
          },
          "setupComplete": {
            "type": "boolean"
          },
