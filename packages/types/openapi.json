            "type": "string",
            "enum": ["role", "details", "consent"],
            "nullable": true
          },
          "draft": {
            "$ref": "#/components/schemas/SetupDraftDto"
          }
        },
        "required": ["complete", "nextStep", "draft"]
      },
      "ConsentDto": {
        "type": "object",
        "properties": {
          "purpose": {
            "type": "string",
            "enum": ["terms", "privacy"]
          },
          "version": {
            "type": "string",
            "example": "2026-10-draft.1"
          }
        },
        "required": ["purpose", "version"]
      },
      "MeDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": ["or", "en", "hi"]
          },
          "mobile": {
            "type": "string",
            "nullable": true,
            "description": "Last four digits only"
          },
          "activeRole": {
            "type": "string",
            "enum": [
              "patient",
              "representative",
              "doctor",
              "dentist",
              "dermatologist",
              "physiotherapist",
              "nurse",
              "attendant",
              "lab",
              "sample_collector",
              "clinic_front_desk",
              "new_account"
            ],
            "description": "The role this session acts in"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleGrantDto"
            }
          },
          "setup": {
            "$ref": "#/components/schemas/SetupStateDto"
          },
          "consentsDue": {
            "description": "Current consent versions not yet given",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentDto"
            }
          }
        },
        "required": ["locale", "mobile", "activeRole", "roles", "setup", "consentsDue"]
      },
      "SetupPatchDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "patient",
              "representative",
              "doctor",
              "dentist",
              "dermatologist",
              "physiotherapist",
              "nurse",
              "attendant",
              "lab",
              "sample_collector"
            ]
          },
          "fullName": {
            "type": "string",
            "maxLength": 100
          },
          "gender": {
            "type": "string",
            "enum": ["female", "male", "other", "undisclosed"]
          },
          "languages": {
            "type": "array",
            "description": "Languages spoken",
            "items": {
              "type": "string",
              "enum": ["or", "en", "hi"]
            }
          },
          "organisationName": {
            "type": "string",
            "maxLength": 120,
            "description": "The lab's name (labs only)"
          },
          "adultDeclared": {
            "type": "boolean",
            "description": "The person confirms they are 18 or older"
          }
        }
      },
      "ConsentsDto": {
        "type": "object",
        "properties": {
          "consents": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsentDto"
            }
          }
        },
        "required": ["consents"]
      },
      "LocaleDto": {
        "type": "object",
        "properties": {
          "locale": {
            "type": "string",
            "enum": ["or", "en", "hi"]
          }
        },
        "required": ["locale"]
      },
      "AddRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "patient",
              "representative",
              "doctor",
              "dentist",
              "dermatologist",
              "physiotherapist",
              "nurse",
              "attendant",
              "lab",
              "sample_collector"
            ]
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["or", "en", "hi"]
            }
          },
          "organisationName": {
            "type": "string",
            "maxLength": 120
          }
        },
        "required": ["role"]
      },
      "TestLoginDto": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["userId"]
      },
      "AdminPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "verifier@heach.invalid"
          },
          "password": {
            "type": "string"
          }
        },
        "required": ["email", "password"]
      },
      "AdminEnrolmentDto": {
        "type": "object",
        "properties": {
          "secret": {
            "type": "string",
            "description": "Base32 secret for the authenticator app; shown once"
          },
          "uri": {
            "type": "string",
            "description": "otpauth:// link with the same secret"
          }
        },
        "required": ["secret", "uri"]
      },
      "AdminPasswordAcceptedDto": {
        "type": "object",
        "properties": {
          "mfaTicket": {
            "type": "string",
