          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": ["mfaTicket", "code"]
      },
      "AdminCodeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": ["code"]
      },
      "AdminMeDto": {
        "type": "object",
        "properties": {
