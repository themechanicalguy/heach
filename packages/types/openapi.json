            "type": "string",
            "format": "date-time"
          },
          "lastSignInAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "name",
          "mobile",
          "status",
          "suspensionReason",
          "roles",
          "setupComplete",
          "createdAt",
          "lastSignInAt"
        ]
      },
      "UserPageDto": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserSummaryDto"
            }
          },
          "total": {
            "type": "number"
          },
          "page": {
            "type": "number"
          },
          "pageSize": {
            "type": "number"
          }
        },
        "required": ["items", "total", "page", "pageSize"]
      },
      "UserDetailDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "nullable": true,
            "description": "Masked"
          },
          "mobile": {
            "type": "string",
            "nullable": true,
            "description": "Last four digits only"
          },
          "status": {
            "type": "string",
            "enum": ["active", "suspended"]
          },
          "suspensionReason": {
            "type": "string",
            "enum": ["safety_concern", "fraud", "policy_breach", "user_request", "other"],
            "nullable": true
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleGrantDto"
            }
          },
          "setupComplete": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastSignInAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "fullName": {
            "type": "string",
            "nullable": true,
            "description": "Full name; this read is audited"
          }
        },
        "required": [
          "id",
          "name",
          "mobile",
          "status",
          "suspensionReason",
          "roles",
          "setupComplete",
          "createdAt",
          "lastSignInAt",
          "fullName"
        ]
      },
      "SuspendDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["safety_concern", "fraud", "policy_breach", "user_request", "other"]
          }
        },
        "required": ["reason"]
      }
    }
  }
}
