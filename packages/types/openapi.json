  "info": {
    "title": "HEACH API",
    "description": "",
    "version": "contract",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        },
        "required": ["status", "version"]
      },
      "ReadinessChecksDto": {
        "type": "object",
        "properties": {
          "postgres": {
            "type": "string",
            "enum": ["ok", "down"]
          },
          "redis": {
            "type": "string",
            "enum": ["ok", "down"]
          }
        },
        "required": ["postgres", "redis"]
      },
      "ReadinessDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok", "error"]
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecksDto"
          }
        },
        "required": ["status", "checks"]
      },
      "AccessTokenDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "expiresIn": {
            "type": "number",
            "description": "Seconds until the access token expires"
          }
        },
        "required": ["accessToken", "expiresIn"]
      },
      "LogoutDto": {
        "type": "object",
        "properties": {
          "allDevices": {
            "type": "boolean"
          }
        },
        "required": ["allDevices"]
      },
      "WebVitalDto": {
        "type": "object",
        "properties": {}
      },
      "CreateNoteDto": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "maxLength": 2000,
            "description": "Restricted: encrypted at rest"
          }
        },
        "required": ["body"]
      },
      "CreatedNoteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["id", "createdAt"]
      },
      "NoteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "body": {
            "type": "string",
            "description": "Restricted"
          }
        },
        "required": ["id", "createdAt", "body"]
      },
      "OtpRequestDto": {
        "type": "object",
        "properties": {
          "mobile": {
            "type": "string",
            "description": "Indian mobile number, with or without +91",
            "example": "9000000001"
          },
          "locale": {
            "type": "string",
            "enum": ["or", "en", "hi"],
            "description": "Language of the SMS and of a new account"
          }
        },
        "required": ["mobile", "locale"]
      },
      "OtpChallengeDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresInSeconds": {
            "type": "number",
            "description": "Seconds until the code expires"
          },
          "resendInSeconds": {
            "type": "number",
            "description": "Seconds until a new code may be requested"
          }
        },
        "required": ["challengeId", "expiresInSeconds", "resendInSeconds"]
      },
      "OtpResendDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "locale": {
            "type": "string",
            "enum": ["or", "en", "hi"]
          }
        },
        "required": ["challengeId", "locale"]
      },
      "OtpVerifyDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "123456"
          },
          "locale": {
            "type": "string",
            "enum": ["or", "en", "hi"]
          }
        },
        "required": ["challengeId", "code", "locale"]
      },
      "SwitchRoleDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "patient",
              "representative",
              "doctor",
              "dentist",
              "dermatologist",
              "physiotherapist",
              "nurse",
              "attendant",
              "lab",
              "sample_collector",
              "clinic_front_desk"
            ]
          }
        },
        "required": ["role"]
      },
      "ReverifyDto": {
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "123456"
          }
        },
        "required": ["challengeId", "code"]
      },
      "RoleGrantDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "patient",
              "representative",
              "doctor",
              "dentist",
              "dermatologist",
              "physiotherapist",
              "nurse",
              "attendant",
              "lab",
              "sample_collector",
              "clinic_front_desk"
            ]
          },
          "side": {
            "type": "string",
            "enum": ["care", "provider"]
          },
          "applicationStatus": {
            "type": "string",
            "enum": [
              "draft",
              "submitted",
              "under_review",
              "changes_requested",
              "approved",
              "rejected",
              "suspended"
            ],
            "nullable": true
          },
          "statusReason": {
            "type": "string",
            "nullable": true,
            "description": "Reason code, never free text"
          }
        },
        "required": ["role", "side", "applicationStatus", "statusReason"]
      },
      "SetupDraftDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "patient",
              "representative",
              "doctor",
              "dentist",
              "dermatologist",
              "physiotherapist",
              "nurse",
              "attendant",
              "lab",
              "sample_collector"
            ],
            "nullable": true
          },
          "fullName": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "type": "string",
            "enum": ["female", "male", "other", "undisclosed"],
            "nullable": true
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["or", "en", "hi"]
            }
          },
          "organisationName": {
            "type": "string",
            "nullable": true
          },
          "adultDeclared": {
            "type": "boolean"
          }
        },
        "required": ["role", "fullName", "gender", "languages", "organisationName", "adultDeclared"]
      },
      "SetupStateDto": {
        "type": "object",
        "properties": {
          "complete": {
            "type": "boolean"
          },
